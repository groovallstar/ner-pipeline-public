{
  "permissions": {
    "allow": [
      "Bash(uv lock:*)",
      "Bash(nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv,noheader)",
      "Bash(nvidia-smi --query-gpu=utilization.gpu,memory.used --format=csv,noheader)",
      "Bash(nvcc --version)",
      "Bash(python -c \"import vllm; print\\(vllm.__version__\\)\")"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuter_gate.py\"",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
