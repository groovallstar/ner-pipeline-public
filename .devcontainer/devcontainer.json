{
  "name": "NER Pipeline Dev",
  "dockerComposeFile": "../docker/dev/docker-compose.yml",
  "service": "ner-pipeline",
  "workspaceFolder": "/work/git/ner_pipeline",

  "remoteUser": "${localEnv:USER}",
  "remoteEnv": {
    "PYTHONPATH": "/work/git/ner_pipeline/src/",
    "HF_HOME": "/work/.huggingface/",
    "OLLAMA_MODELS": "/data/.ollama/"
  },

  "initializeCommand": "mkdir -p ${HOME}/dev/.claude && export DOCKER_UID=$(id -u) && export DOCKER_GID=$(id -g) && echo \"DOCKER_UID=${DOCKER_UID}, DOCKER_GID=${DOCKER_GID}, USER=${USER}\"",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.pylint",
        "ms-python.debugpy",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "ms-ceintl.vscode-language-pack-ko",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "anthropic.claude-code",
        "donjayamanne.githistory",
        "njpwerner.autodocstring"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
