# syntax=docker/dockerfile:1
FROM pytorch/pytorch:2.11.0-cuda13.0-cudnn9-devel

SHELL ["/bin/bash", "-c"]

# Build args for host user mapping
ARG USERNAME=devuser
ARG USER_UID=1000
ARG USER_GID=1000

RUN <<EOF
# apt-get package
apt-get update
apt-get install -y liblzma-dev libbz2-dev git-lfs curl vim sudo

# docker cli 설치
apt-get install -y ca-certificates curl gnupg lsb-release
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
apt-get update
apt-get install -y docker-ce-cli docker-compose-plugin

# Node.js LTS via NodeSource (nvm 없이)
curl -fsSL https://deb.nodesource.com/setup_lts.x | bash -
apt-get install -y nodejs

# timezone
export DEBIAN_FRONTEND=noninteractive
ln -fs /usr/share/zoneinfo/Asia/Seoul /etc/localtime
apt-get install -y tzdata
dpkg-reconfigure --frontend noninteractive tzdata
EOF

# uv 설치 (전역 경로에 설치)
RUN curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh

# install packages via uv sync (root 권한으로 먼저 수행)
COPY ./docker/dev/pyproject.toml .
COPY ./docker/dev/uv.lock .
COPY ./docker/dev/.python-version .
RUN uv sync --frozen --system-certs

# 호스트 사용자와 동일한 UID/GID를 가진 사용자 생성
# 베이스 이미지의 기존 uid/gid 충돌 사용자 제거 (예: ubuntu)
RUN EXISTING_USER=$(getent passwd ${USER_UID} | cut -d: -f1) && \
    if [ -n "$EXISTING_USER" ] && [ "$EXISTING_USER" != "${USERNAME}" ]; then \
        userdel -r "$EXISTING_USER" 2>/dev/null || true; \
    fi && \
    EXISTING_GROUP=$(getent group ${USER_GID} | cut -d: -f1) && \
    if [ -n "$EXISTING_GROUP" ] && [ "$EXISTING_GROUP" != "${USERNAME}" ]; then \
        groupdel "$EXISTING_GROUP" 2>/dev/null || true; \
    fi && \
    groupadd --gid ${USER_GID} ${USERNAME} 2>/dev/null || true && \
    useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME} && \
    chmod 0440 /etc/sudoers.d/${USERNAME}

# uv를 사용자 홈에도 설치
RUN su - ${USERNAME} -c "curl -LsSf https://astral.sh/uv/install.sh | sh"

# 사용자 환경 설정
RUN <<EOF
USER_HOME=$(eval echo ~${USERNAME})

echo "alias ll='ls \$LS_OPTIONS -alh'" >> ${USER_HOME}/.bashrc

# set environments
echo "export LC_ALL=C.UTF-8" >> ${USER_HOME}/.bashrc
echo "export LANG=C.UTF-8" >> ${USER_HOME}/.bashrc
echo "export HF_HOME=${USER_HOME}/.huggingface/" >> ${USER_HOME}/.bashrc
echo "export PATH=/usr/bin:\$PATH" >> ${USER_HOME}/.bashrc
echo "export PATH=${USER_HOME}/.local/bin:\$PATH" >> ${USER_HOME}/.bashrc

chown ${USER_UID}:${USER_GID} ${USER_HOME}/.bashrc
EOF

# openspec, oh-my-claudecode 설치 (root 권한)
RUN npm install -g @fission-ai/openspec@latest && \
    npm install -g oh-my-claude-sisyphus@latest

# Claude Code 설치 (사용자 권한)
USER ${USERNAME}
RUN curl -fsSL https://claude.ai/install.sh | bash
