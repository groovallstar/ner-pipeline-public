# ner-server 설정 표면 — 이 파일을 .env 로 복사해 값을 채운다(compose 자동
# 로드). 주석 처리된 항목은 compose 기본값(= 아래 주석의 값)을 따른다.

# --- 배포 토폴로지 ---
# NER_SERVER_IMAGE=ner-server:0.1.0       # 빌드·실행 이미지 태그(:latest 금지)
# NER_SERVER_CONTAINER=ner-server         # 컨테이너명
# NER_SERVER_PROJECT=ner-server           # compose 프로젝트명(start/stop 공유)
# NER_SERVER_DATA_DIR=/data               # 호스트 모델 루트(→ 컨테이너 /data)
# NER_SERVER_GPU=0                        # 컨테이너에 노출할 호스트 GPU 인덱스(1장 고정, 기본 0)

# --- 런타임(NER_SERVER_*) ---
# NER_SERVER_PORT=8008                    # 바인드·publish 포트
# NER_SERVER_MODEL_ROOT=/data/ner         # 컨테이너 내 모델 루트
# NER_SERVER_MAX_LENGTH=256               # 모델 토큰 한도(초과 시 chunk)
# NER_SERVER_MAX_CHARS=20000              # 텍스트 1건 char 상한
# NER_SERVER_MAX_BATCH=64                 # 배치 텍스트 개수 상한
# NER_SERVER_MAX_TOTAL_CHARS=100000       # 배치 char 합산 상한(작업량 가드)
# NER_SERVER_MAX_BODY_BYTES=2097152       # 요청 바디 바이트 상한(전송 가드, 2MB)
# NER_SERVER_MAX_CONCURRENCY=8            # 동시 추론 상한(전역 세마포어)
# NER_SERVER_MAX_QUEUE=32                 # 대기 큐 깊이(초과 시 429)
# NER_SERVER_ACQUIRE_TIMEOUT_S=10         # 세마포어 대기 타임아웃 초(초과 429)
# NER_SERVER_API_KEY=                     # 미설정=인증 off(내부망 신뢰 전제)
# NER_SERVER_LOG_LEVEL=INFO               # DEBUG 로 요청별 상세 로그(기본 조용)
# NER_SERVER_LOG_FILE=/tmp/ner-server.log # 주간 회전 파일 로그(일주일 보관, 빈 값=stderr만)

# --- 한국어 번역(웹 데모 UI 전용, 기본 비활성) ---
# 켜면 /v1/translate + UI '한국어 번역 보기' 버튼 활성 — /v1/ner 코어와는 독립
# (비활성·백엔드 미가용이면 UI 는 NER 만 표시). PII(전화·카드 등)는 마스킹-복원
# 으로 원문 그대로 보존하며 번역기에 노출하지 않는다(외부 API 금지 — 온프렘만).
#
# 번역기는 원격 온프렘 LLM(vLLM 등 OpenAI 호환) 하나다. MODEL·BASE_URL 은
# 기본값이 없어 안 주면 서버가 안 뜬다 — 기본값을 두면 그 포트에 떠 있는 다른
# 모델을 조용히 번역기로 쓰게 되고, 설정만 보고 무엇을 부르는지 알 수 없다.
# NER_SERVER_TRANSLATE_ENABLED=false      # true 로 활성
# NER_SERVER_TRANSLATE_MODEL=             # 활성 시 필수 — 엔드포인트가 서빙 중인 이름
#                                         #   (예: cyankiwi/gemma-4-31B-it-AWQ-8bit)
# NER_SERVER_TRANSLATE_BASE_URL=          # 활성 시 필수 — 예: http://host.docker.internal:8081/v1
#   주의: 컨테이너 안에서는 localhost 가 호스트 vLLM 에 닿지 않는다 —
#   host.docker.internal 또는 compose 네트워크의 서비스 주소로 지정한다.
# NER_SERVER_TRANSLATE_MAX_CONCURRENCY=2  # 번역 동시 처리 상한(초과 429). NER 예산과 별도
# NER_SERVER_TRANSLATE_API_KEY=           # OpenAI 호환 키(vLLM 은 불필요)
# NER_SERVER_TRANSLATE_TIMEOUT_S=30       # LLM 호출 타임아웃 초(미설정 시 30)
